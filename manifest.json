{
  "manifest_version": 3,
  "name": "yt-dlp Link Launcher",
  "version": "2.0.0",
  "description": "Rewrites clicked video links from any site yt-dlp supports into a custom URL scheme that opens a local program.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["patterns.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
